# Finite-horizon settings and termination are in the companion TOML file.
discount: 1.0
values: reward
states: s0 s1 s2 s3
actions: a0 a1
observations: o0
start: uniform
T: a0 identity
T: a0 : s1 : s0 0.8
T: a0 : s1 : s1 0.1
T: a0 : s1 : s2 0.1
T: a0 : s2 : s1 0.8
T: a0 : s2 : s2 0.1
T: a0 : s2 : s3 0.1
R: a0 : s1 : * : * 0.8
T: a1 identity
T: a1 : s1 : s0 0.1
T: a1 : s1 : s1 0.1
T: a1 : s1 : s2 0.8
T: a1 : s2 : s1 0.1
T: a1 : s2 : s2 0.1
T: a1 : s2 : s3 0.8
R: a1 : s2 : * : * 0.8
O: * uniform
